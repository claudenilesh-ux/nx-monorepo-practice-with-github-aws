POSTGRES_USER=replace_with_local_user
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql://replace_with_local_user:replace_with_local_password@127.0.0.1:5432/archloom?schema=public
# Cloud profile: set DATABASE_URL to the pooled TCP URL and DIRECT_URL to
# the matching direct TCP URL from Prisma Console; both require TLS.
DIRECT_URL=
CLERK_PUBLISHABLE_KEY=replace_with_clerk_publishable_key
CLERK_SECRET_KEY=replace_with_clerk_secret_key
CORS_ORIGIN=http://localhost:3000
